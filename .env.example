# =============================================================================
# promptlab works with ANY OpenAI-compatible endpoint. Pick one and uncomment.
# =============================================================================

# ----- Default: OpenAI -----
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_STUDENT=gpt-4o-mini
MODEL_JUDGE=gpt-4o-mini

# ----- OpenRouter (one key, hundreds of models) -----
# OPENAI_API_KEY=sk-or-v1-...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# MODEL_STUDENT=anthropic/claude-haiku-4-5
# MODEL_JUDGE=anthropic/claude-haiku-4-5

# ----- Groq (very fast) -----
# OPENAI_API_KEY=gsk_...
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# MODEL_STUDENT=llama-3.3-70b-versatile
# MODEL_JUDGE=llama-3.3-70b-versatile

# ----- Together AI -----
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=https://api.together.xyz/v1
# MODEL_STUDENT=meta-llama/Llama-3.3-70B-Instruct-Turbo
# MODEL_JUDGE=meta-llama/Llama-3.3-70B-Instruct-Turbo

# ----- DeepSeek -----
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# MODEL_STUDENT=deepseek-chat
# MODEL_JUDGE=deepseek-chat

# ----- Mistral La Plateforme -----
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=https://api.mistral.ai/v1
# MODEL_STUDENT=mistral-large-latest
# MODEL_JUDGE=mistral-large-latest

# ----- Ollama (local, free, slower) -----
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# MODEL_STUDENT=llama3.2
# MODEL_JUDGE=llama3.2
# JUDGE_JSON_MODE=false   # some Ollama models don't reliably honor JSON mode

# ----- LM Studio (local) -----
# OPENAI_API_KEY=lmstudio
# OPENAI_BASE_URL=http://localhost:1234/v1
# MODEL_STUDENT=local-model
# MODEL_JUDGE=local-model
# JUDGE_JSON_MODE=false

# ----- vLLM (local / cluster) -----
# OPENAI_API_KEY=any
# OPENAI_BASE_URL=http://your-vllm-host:8000/v1
# MODEL_STUDENT=meta-llama/Llama-3.3-70B-Instruct
# MODEL_JUDGE=meta-llama/Llama-3.3-70B-Instruct

# =============================================================================
# Tip: keep STUDENT cheap (it tries every prompt you write) and JUDGE smart
# (it grades the result). They don't have to be the same model.
# =============================================================================
